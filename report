#!/usr/bin/env bash
# ============================================================
# BAYABA_LOG 리포팅 라인 · Telegram: @bayaba_bot
# 터미널 결과를 텔레그램으로 전송합니다.
#
# 사용법:
#   ./report "메시지"            # 직접 메시지 전송
#   cat result.txt | ./report    # 파이프로 전송
#   ls -la | ./report "목록"     # 파이프 + 제목
#   ./report --check             # chat_id 확인
#   ./report --setup             # 초기 설정
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONF="$SCRIPT_DIR/report.conf"

# ---- 설정 로드 ----
if [ -f "$CONF" ]; then
  source "$CONF"
else
  # fallback: environment variables
  BOT_TOKEN="${BOT_TOKEN:-}"
  CHAT_ID="${CHAT_ID:-}"
fi

BOT_TOKEN="${BOT_TOKEN:-여기에_봇_토큰_입력}"
API="https://api.telegram.org/bot${BOT_TOKEN}"

# ---- 유틸리티 ----
bold() { printf '\033[1m%s\033[0m' "$*"; }
ok()   { printf ' \033[32m✓\033[0m %s\n' "$*"; }
fail() { printf ' \033[31m✕\033[0m %s\n' "$*"; }

# ---- chat_id 확인 ----
check_chat_id() {
  echo "$(bold '🔍') chat_id 확인 중..."
  local updates
  updates=$(curl -s "${API}/getUpdates" 2>/dev/null)

  if ! echo "$updates" | grep -q '"ok":true'; then
    fail "API 연결 실패: $updates"
    return 1
  fi

  local count
  count=$(echo "$updates" | grep -o '"update_id"' | wc -l)

  if [ "$count" -eq 0 ]; then
    echo ""
    echo "  $(bold '아직 메시지가 없습니다.')"
    echo "  텔레그램에서 @bayaba_bot 에게"
    echo "  아무 메시지나 보낸 후 다시 실행하세요."
    echo ""
    return 1
  fi

  # chat_id 추출 (가장 최근 메시지)
  local cid
  cid=$(echo "$updates" | grep -o '"chat":{"id":[0-9-]*' | tail -1 | grep -o '[0-9-]*$')
  local username
  username=$(echo "$updates" | grep -o '"username":"[^"]*"' | tail -1 | cut -d'"' -f4)
  local firstname
  firstname=$(echo "$updates" | grep -o '"first_name":"[^"]*"' | tail -1 | cut -d'"' -f4)
  local text
  text=$(echo "$updates" | grep -o '"text":"[^"]*"' | tail -1 | cut -d'"' -f4)

  echo ""
  ok   "chat_id 발견!"
  printf '     chat_id   : %s\n' "$(bold "$cid")"
  printf '     사용자    : %s (@%s)\n' "${firstname:-?}" "${username:-?}"
  printf '     마지막 메시지: %s\n' "\"${text:-?}\""

  # 자동으로 conf 파일 업데이트
  sed -i "s/^CHAT_ID=.*/CHAT_ID=${cid}/" "$CONF"
  ok "report.conf 업데이트 완료! 이제 바로 사용할 수 있습니다."

  CHAT_ID="$cid"
}

# ---- 메시지 전송 ----
send_message() {
  local msg="$1"

  if [ -z "$CHAT_ID" ]; then
    fail "CHAT_ID가 설정되지 않았습니다. 먼저 ./report --check 를 실행하세요."
    return 1
  fi

  # 긴 메시지는 자르지 않고 markdown escape 처리
  # HTML parse mode: < > & 만 escape
  local escaped
  escaped=$(echo "$msg" | sed 's/&/&amp;/g; s/</&lt;/g; s/>/&gt;/g')

  local resp
  resp=$(curl -s -X POST "${API}/sendMessage" \
    -d "chat_id=${CHAT_ID}" \
    -d "text=${escaped}" \
    -d "parse_mode=HTML" \
    -d "disable_web_page_preview=true" 2>/dev/null)

  if echo "$resp" | grep -q '"ok":true'; then
    return 0
  else
    # HTML 파싱 실패 시 plain text로 재시도
    resp=$(curl -s -X POST "${API}/sendMessage" \
      -d "chat_id=${CHAT_ID}" \
      -d "text=${msg}" \
      -d "disable_web_page_preview=true" 2>/dev/null)

    if echo "$resp" | grep -q '"ok":true'; then
      return 0
    fi

    echo "전송 실패: $resp" >&2
    return 1
  fi
}

# ---- 메인 ----
main() {
  case "${1:-}" in
    --check|-c)
      check_chat_id
      exit $?
      ;;

    --setup|-s)
      check_chat_id
      exit $?
      ;;

    --help|-h)
      echo "BAYABA_LOG 리포팅 라인 · @bayaba_bot"
      echo ""
      echo "사용법:"
      echo "  command | ./report [제목]     파이프로 결과 전송"
      echo "  ./report \"메시지\"             직접 메시지 전송"
      echo "  ./report --check              chat_id 확인/설정"
      echo "  ./report --help               도움말"
      exit 0
      ;;

    *)
      # 파이프 입력 감지
      local title="$*"
      local stdin_content

      if [ ! -t 0 ]; then
        # stdin 있음 (파이프)
        stdin_content=$(cat)
      fi

      local full_msg

      if [ -n "$stdin_content" ] && [ -n "$title" ]; then
        # 파이프 + 제목
        full_msg="<b>📋 ${title}</b>
<pre>${stdin_content}</pre>"
      elif [ -n "$stdin_content" ]; then
        # 파이프만
        full_msg="<pre>${stdin_content}</pre>"
      elif [ -n "$title" ]; then
        # 직접 메시지만
        full_msg="${title}"
      else
        echo "사용법: echo \"결과\" | ./report [제목]" >&2
        echo "       ./report \"메시지\"" >&2
        exit 1
      fi

      send_message "$full_msg"
      local ret=$?
      if [ $ret -eq 0 ]; then
        ok "리포트 전송 완료 → Telegram @bayaba_bot"
      fi
      exit $ret
      ;;
  esac
}

main "$@"
